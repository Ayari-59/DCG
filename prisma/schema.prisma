// Base du cahier de texte. Volontairement minimale : une séance, et c'est
// tout. Les comptes élèves viendront s'ajouter ici le jour où le site
// s'ouvrira au-delà de la classe.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL ne vit plus ici. Les commandes CLI la lisent dans
// prisma.config.ts, et le client la reçoit via l'adaptateur (lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// Compte enseignant. Le fondateur invite ses collègues ; chaque
/// enseignant gère ses propres classes dans le cahier de texte.
model Enseignant {
  id        String              @id @default(cuid())
  email     String              @unique
  prenom    String
  /// « fondateur » invite, voit tout et règle la visibilité des
  /// ressources ; « enseignant » gère ses classes.
  role      String              @default("enseignant")
  /// Empreinte scrypt du mot de passe, au format « sel.empreinte » (hex).
  empreinte String
  createdAt DateTime            @default(now())
  sessions  SessionEnseignant[]
  seances   Seance[]
  annonces  Annonce[]
}

model SessionEnseignant {
  /// Empreinte SHA-256 du jeton : le jeton en clair ne vit que dans le cookie.
  jeton        String     @id
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  expire       DateTime
  createdAt    DateTime   @default(now())

  @@index([enseignantId])
}

model Seance {
  id        String   @id @default(cuid())
  /// Date de la séance en classe.
  date      DateTime
  /// Nom libre de la classe : permet d'en gérer plusieurs sans modèle dédié.
  classe    String
  /// Identifiant du chapitre du site (ex. « dcg-ue11-methode-abc »).
  chapitre  String
  /// Sections traitées, telles que saisies : « 1-3 », « 1,4,5 »…
  sections  String?
  travail   String?
  /// Échéance du travail à faire.
  pourLe    DateTime?
  remarques String?
  /// Lien vers la visioconférence (Zoom, Teams, Meet…).
  lienVisio String?
  /// Une séance non publiée reste invisible côté étudiant.
  publiee   Boolean  @default(true)
  /// L'enseignant qui a créé la séance ; chacun ne gère que les siennes,
  /// le fondateur les voit toutes.
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classe, date])
  @@index([enseignantId])
}

/// Compte apprenant. Facultatif : le site entier se consulte sans compte,
/// celui-ci n'ajoute que la sauvegarde de la progression et l'accès aux
/// ressources que l'auteur choisit de réserver.
model Apprenant {
  id           String             @id @default(cuid())
  email        String             @unique
  prenom       String
  /// Empreinte scrypt du mot de passe, au format « sel.empreinte » (hex).
  /// Le mot de passe lui-même n'est jamais stocké.
  empreinte    String
  /// Horodatage du consentement donné à l'inscription (RGPD).
  consentement DateTime
  createdAt    DateTime           @default(now())
  sessions     SessionApprenant[]
  progressions Progression[]
}

model SessionApprenant {
  /// Empreinte SHA-256 du jeton : le jeton en clair ne vit que dans le
  /// cookie de l'apprenant — un vol de base ne vole pas les sessions.
  jeton       String    @id
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  expire      DateTime
  createdAt   DateTime  @default(now())

  @@index([apprenantId])
}

/// Progression d'un apprenant sur un chapitre : meilleur score au quiz et
/// cartes acquises. Une ligne par couple apprenant × chapitre.
model Progression {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  /// Slug du chapitre (ex. « dcg-ue11-methode-abc »).
  chapitre    String
  quizScore   Int?
  quizTotal   Int?
  /// Identifiants des flashcards acquises.
  cartes      Json      @default("[]")
  /// Auto-évaluation des applications : { idExercice: "reussi" | "partiel" | "a-revoir" }.
  applications Json     @default("{}")
  updatedAt   DateTime  @updatedAt

  @@unique([apprenantId, chapitre])
}

/// Annonce visible sur la page classe et/ou la page d'accueil.
model Annonce {
  id           String      @id @default(cuid())
  titre        String
  contenu      String
  /// Classe ciblée ; null = toutes les classes (annonce générale).
  classe       String?
  /// Une annonce non publiée reste invisible côté étudiant.
  publiee      Boolean     @default(true)
  /// Une annonce épinglée reste en tête de liste.
  epinglee     Boolean     @default(false)
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([enseignantId])
  @@index([publiee, classe])
}

/// Réglages du site modifiables depuis l'espace professeur — notamment la
/// liste des ressources réservées aux apprenants connectés.
model Reglage {
  cle    String @id
  valeur String
}
