// Base du cahier de texte. Volontairement minimale : une séance, et c'est
// tout. Les comptes élèves viendront s'ajouter ici le jour où le site
// s'ouvrira au-delà de la classe.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL ne vit plus ici. Les commandes CLI la lisent dans
// prisma.config.ts, et le client la reçoit via l'adaptateur (lib/db.ts).
datasource db {
  provider = "postgresql"
}

model Seance {
  id        String   @id @default(cuid())
  /// Date de la séance en classe.
  date      DateTime
  /// Nom libre de la classe : permet d'en gérer plusieurs sans modèle dédié.
  classe    String
  /// Identifiant du chapitre du site (ex. « dcg-ue11-methode-abc »).
  chapitre  String
  /// Sections traitées, telles que saisies : « 1-3 », « 1,4,5 »…
  sections  String?
  travail   String?
  /// Échéance du travail à faire.
  pourLe    DateTime?
  remarques String?
  /// Une séance non publiée reste invisible côté étudiant.
  publiee   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classe, date])
}

/// Compte apprenant. Facultatif : le site entier se consulte sans compte,
/// celui-ci n'ajoute que la sauvegarde de la progression et l'accès aux
/// ressources que l'auteur choisit de réserver.
model Apprenant {
  id           String             @id @default(cuid())
  email        String             @unique
  prenom       String
  /// Empreinte scrypt du mot de passe, au format « sel.empreinte » (hex).
  /// Le mot de passe lui-même n'est jamais stocké.
  empreinte    String
  /// Horodatage du consentement donné à l'inscription (RGPD).
  consentement DateTime
  createdAt    DateTime           @default(now())
  sessions     SessionApprenant[]
  progressions Progression[]
}

model SessionApprenant {
  /// Empreinte SHA-256 du jeton : le jeton en clair ne vit que dans le
  /// cookie de l'apprenant — un vol de base ne vole pas les sessions.
  jeton       String    @id
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  expire      DateTime
  createdAt   DateTime  @default(now())

  @@index([apprenantId])
}

/// Progression d'un apprenant sur un chapitre : meilleur score au quiz et
/// cartes acquises. Une ligne par couple apprenant × chapitre.
model Progression {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  /// Slug du chapitre (ex. « dcg-ue11-methode-abc »).
  chapitre    String
  quizScore   Int?
  quizTotal   Int?
  /// Identifiants des flashcards acquises.
  cartes      Json      @default("[]")
  updatedAt   DateTime  @updatedAt

  @@unique([apprenantId, chapitre])
}

/// Réglages du site modifiables depuis l'espace professeur — notamment la
/// liste des ressources réservées aux apprenants connectés.
model Reglage {
  cle    String @id
  valeur String
}
